# Configuración de Entorno para MVP Social Listening

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# GitHub
# La CLI ya está autenticada localmente como Jornielrd.
# Si requieres autenticación de API directa, especifica un PAT aquí:
GITHUB_PAT=your_github_pat

# Notion
NOTION_TOKEN=your_notion_token
NOTION_PAGE_OR_DATABASE_ID=your_notion_database_id

